# Normalize line endings: LF both in the repository and in the working copy.
# The working copy was left native until the pre-commit hooks started rewriting
# files with LF on every run, which made Git report content-identical files as
# modified; pinning the checkout to LF ends that churn.
* text=auto eol=lf

*.nvda-addon binary

# Keep source line numbers out of .po files. Needs the filter configured once:
# git config --global filter.cleanpo.clean "msgcat - --no-location"
*.po filter=cleanpo
