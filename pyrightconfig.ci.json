{
	// Used only by CI -- .github/workflows/checks.yml on every commit and
	// release_checks.yml before a release -- which checks NVDA's source out next to
	// the repository first. Which NVDA that is differs between the two, the newest
	// supported release and the oldest, and nothing in this file depends on which one is
	// lying there: that is why one configuration serves both runs instead of a copy per
	// end of the range. The configuration in pyproject.toml excludes the shell
	// of the add-on, because without that checkout every symbol taken from NVDA is unknown
	// and strict mode reports the whole file.
	"typeCheckingMode": "strict",
	"pythonPlatform": "Windows",
	// Both ends of the supported range execute the add-on under Python 3.11: NVDA 2025.3,
	// named by `addon_lastTestedNVDAVersion` in buildVars.py, and NVDA 2025.1, named by
	// `addon_minimumNVDAVersion` beside it. The build environment runs a newer Python,
	// which must not tempt the add-on into syntax the screen reader cannot execute.
	//
	// One number covers both runs only while the two releases agree on it. The day a
	// raised `addon_lastTestedNVDAVersion` brings a newer Python than the floor's, this
	// cannot become a second value here -- a file has one `pythonVersion` -- and the
	// floor needs a configuration of its own. docs/development.md, "Перевірки перед
	// комітом", lists what moves with which field.
	"pythonVersion": "3.11",
	"include": ["addon"],
	"extraPaths": ["./addon", "../nvda/source"],
	"venvPath": ".venv",
	"venv": ".",
	// wxPython's own stubs are generated by sip: no `py.typed`, and not one return type
	// among the thousands of methods in core.pyi. NVDA's source is not typed through
	// either. Strict mode would report every call into either as unknown, so the rules
	// that only measure how much pyright could infer are off, as they are in NVDA's own
	// configuration. What stays on is what this check exists for: an import that does not
	// resolve, a method that does not exist, an argument of the wrong declared type, an
	// Optional used as if it were not. The core keeps these rules through the local
	// configuration in pyproject.toml. docs/development.md, "Перевірки перед комітом",
	// has the measurements behind this.
	//
	// The rules pyproject.toml turns on above strict -- reportUnusedCallResult,
	// reportImportCycles, reportImplicitStringConcatenation and the rest -- are not
	// inherited here, and that is a decision rather than an omission: pyright's
	// `extends` would carry them over from pyproject.toml in one line. Measured
	// against the shell (#23), they report nineteen things, and not one of them points
	// at a defect: twelve are reportUnusedCallResult on the wx idiom (`sizer.Add(...)`,
	// `addButton(...)`), four are the cycle pyright sees whenever a module reaches a
	// sibling through the package (`from . import signals`), two are translator strings
	// wrapped across lines on purpose, and one is a widget built in a helper that
	// __init__ calls. NVDA's own configuration turns all five of those rules off,
	// counting them in the hundreds and thousands. The one finding worth having was a
	// terminate without @override, and it is in the code instead.
	"reportMissingTypeStubs": false,
	"reportUnknownMemberType": false,
	"reportUnknownVariableType": false,
	"reportUnknownArgumentType": false,
	"reportUnknownParameterType": false,
	"reportUnknownLambdaType": false
}
